# =============================================================================
# CheckinBliss — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# The app runs in mock mode with no credentials set.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Can use sb_publishable_... or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Can use sb_secret_... or legacy service_role key
SUPABASE_SECRET_KEY=

# --- Stripe ---
# Obtain both keys from the Stripe Dashboard → Developers → API keys.
# STRIPE_SECRET_KEY (sk_...) is server-only; the publishable key
# (NEXT_PUBLIC_STRIPE_PK, pk_...) is safe for the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PK=

# Stripe Connect — Nigerian subsidiary's connected-account id.
# When set, charges include `application_fee_amount` (12% commission)
# and the net amount is transferred to this connected account.
STRIPE_CONNECT_ACCOUNT_ID=

# --- Raenest (NGN payout partner) ---
# Owner share (88%) is disbursed to Nigerian property owners via Raenest.
# Mock mode works without these credentials.
RAENEST_API_KEY=
RAENEST_BASE_URL=https://api.raenest.com/v1

# GBP → NGN reference rate for owner payout conversion (default 2450).
# Used informatically in mock mode; production rate comes from Raenest.
NEXT_PUBLIC_GBP_TO_NGN_RATE=2450

# --- App ---
# Absolute base URL used to build Checkout success/cancel redirects when the
# caller does not pass success_url/cancel_url (e.g. https://checkinbliss.com).
NEXT_PUBLIC_APP_URL=

# --- Auth ---
AUTH_SECRET=

# --- Cron + Admin ---
CRON_SECRET=

# Founder-only gate for the admin dashboard and all admin mutations.
# In production: required. Admin routes (claims, operators, properties)
# and Server Actions return 401 / refuse to render when this is missing.
# In mock mode (no Supabase or Stripe keys, NODE_ENV != production):
# bypassed automatically so dev login keeps working.
# Pass via the x-admin-key request header or via /admin?admin_key=<key>
# to unlock the dashboard in a real browser.
ADMIN_DASH_KEY=

# --- WhatsApp Business (Meta Cloud API) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Mapbox GL JS (public token, URL-restricted in production) ---
# CRITICAL: This MUST be a PUBLIC token (prefix "pk."), NOT a secret token ("sk.").
# Secret tokens are for server-side API calls only and will be rejected by the
# Mapbox tile CDN when used client-side — the map will render as a blank canvas.
# Create one at https://account.mapbox.com/access-tokens/ → "Create a token".
# URL-restrict this token in the Mapbox dashboard to your production domain
# (e.g. checkinbliss.vercel.app) so it can't be reused elsewhere.
# The app shows a styled "Map unavailable" fallback when this is missing or invalid.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Turnstile (Cloudflare CAPTCHA) ---
# Get keys at https://dash.cloudflare.com/ → Turnstile → Add site
# In mock mode (no secret key set), verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Airtable (property onboarding tracker) ---
AIRTABLE_BASE_ID=
AIRTABLE_TOKEN=
